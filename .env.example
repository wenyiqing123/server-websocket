# Copy this file to .env and replace every placeholder with local or deployment values.
# Never commit .env or paste real credentials into application.yaml.
APP_ENV=development
JWT_SECRET=replace_with_a_long_random_secret

DB_URL=jdbc:mysql://127.0.0.1:3306/chat?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_user
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VIRTUAL_HOST=/websocket

MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your_mailbox@example.com
MAIL_PASSWORD=your_mail_password

DASHSCOPE_API_KEY=your_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode

ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=https://your-public-domain.example.com/alipay/notify

DRUID_CONSOLE_USERNAME=admin
DRUID_CONSOLE_PASSWORD=replace_with_a_console_password
